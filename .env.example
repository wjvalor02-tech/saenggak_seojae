# Supabase Edge Function 비밀값(Secrets)에 넣을 값들. 실제 키는 이 파일에 쓰지 말 것.
AI_PROVIDER=gemini            # gemini | anthropic
AI_MODEL=                     # 비우면 기본값(gemini-2.5-flash / claude-haiku-5-5). 최신 경량 모델명으로 바꿔도 됨
GEMINI_API_KEY=               # Google AI Studio에서 발급
ANTHROPIC_API_KEY=            # (Claude로 바꿀 때) Anthropic Console에서 발급
AI_DAILY_LIMIT=300            # 하루 AI 호출 상한

# 앱 쪽(app/config.js)에 넣는 값 — 공개돼도 되는 값
# supabaseUrl=https://xxxx.supabase.co
# supabaseAnonKey=eyJ...
